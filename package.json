{
  "name": "narada",
  "version": "0.1.0",
  "description": "P2P browser tab/session sync over WebRTC with Nostr signaling",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.mjs src/icons",
    "package": "npm run build && cd dist/chromium && zip -qr ../narada-chrome.zip . && cd ../firefox && zip -qr ../narada-firefox.zip .",
    "e2e:prepare": "npm run build && node test/e2e/prepare.mjs",
    "e2e:chromium": "node test/e2e/chromium-to-chromium.cjs",
    "e2e:firefox": "node test/e2e/chromium-to-firefox.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmdhrumilmistry/websync.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dmdhrumilmistry/websync/issues"
  },
  "homepage": "https://github.com/dmdhrumilmistry/websync#readme",
  "devDependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "esbuild": "^0.28.2",
    "selenium-webdriver": "^4.0.0"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  },
  "private": true,
  "type": "module"
}
